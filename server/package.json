{
  "name": "tabinet-server",
  "private": true,
  "description": "Tabinet sync server: stores end-to-end encrypted records for signed-in users.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/dev.ts",
    "start": "node --import tsx src/railway.adaptor.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.9",
    "@neondatabase/serverless": "1.2.1",
    "hono": "4.13.19",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@types/node": "^26.6.6",
    "typescript": "6.0.3",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
