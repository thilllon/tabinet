{
  "name": "tabinet-server",
  "private": true,
  "description": "Tabinet sync server: stores end-to-end encrypted records for signed-in users.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/dev.ts",
    "start": "node --import tsx src/railway.adaptor.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx scripts/migrate.ts",
    "schema:check": "tsx scripts/schema-check.ts",
    "key-encryption-key:new": "tsx scripts/key-encryption-key.ts new",
    "key-encryption-key:id": "tsx scripts/key-encryption-key.ts id",
    "stream-check": "tsx scripts/stream-check.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.8",
    "@neondatabase/serverless": "1.2.0",
    "hono": "4.13.18",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@types/node": "^26.6.6",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
