# The sync server's environment (Vercel project tabinet-server; a Railway service takes the same
# three variables, and sets PORT itself, see README.md). Copy to .env.production /
# .env.preview and fill in; those files are git-ignored.
# Postgres connection string (Neon project `tabinet`):
#   neonctl connection-string --project-id empty-breeze-89240129 --pooled
DATABASE_URL=
# Comma-separated Google OAuth client ids allowed to sign in (CLOUD_SYNC.googleClientId in src/constants.ts)
GOOGLE_CLIENT_IDS=
# Comma-separated origins allowed to call the API
ALLOWED_ORIGINS=chrome-extension://bmbpmnfhfbdjdjpblimidmbohgccmjdg

# Not read by the server (a host holds only the three above); for local tooling.
# Direct (unpooled) connection, for migrations and psql:
#   neonctl connection-string --project-id empty-breeze-89240129
DATABASE_URL_UNPOOLED=
NEON_PROJECT_ID=empty-breeze-89240129
NEON_REGION=aws-ap-southeast-1
# From server/.vercel/project.json (created by `vercel link`)
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VERCEL_PROJECT_NAME=tabinet-server
VERCEL_TEAM_SLUG=thilllons
API_BASE=https://tabinet-server.vercel.app
STORE_EXTENSION_ID=bmbpmnfhfbdjdjpblimidmbohgccmjdg
