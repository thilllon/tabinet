---
import { Image } from 'astro:assets';

import { localePaths, type Locale } from '../../../i18n/locales';
import { ubermenschCopy } from '../../../i18n/ubermensch-copy';
import { ubermenschShot } from '../../../i18n/ubermensch-shots';
import UbermenschLayout from '../../../layouts/ubermensch-layout.astro';

export function getStaticPaths() {
  return localePaths();
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = ubermenschCopy(locale);
const SHOT_SIZES = '(min-width: 60rem) 48rem, calc(100vw - 2.5rem)';
---

<UbermenschLayout locale={locale} page="home" title={copy.meta.homeTitle} description={copy.meta.homeDescription}>
  <section class="container narrow hero">
    <p class="kicker">{copy.hero.eyebrow}</p>
    <h1>{copy.hero.title}</h1>
    <p class="section-lead">{copy.hero.lead}</p>
    <p class="status">{copy.hero.status}</p>
    <figure class="shot">
      <Image src={ubermenschShot(locale, 1)} alt={copy.hero.imageAlt} widths={[640, 960, 1280]} sizes={SHOT_SIZES} loading="eager" />
    </figure>
  </section>

  <section class="container narrow block">
    <h2>{copy.features.title}</h2>
    <div class="cards">
      {
        copy.features.items.map((item) => (
          <article class="card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))
      }
    </div>
    <div class="shots">
      {
        ([2, 5] as const).map((n) => (
          <figure class="shot">
            <Image src={ubermenschShot(locale, n)} alt="" widths={[640, 960]} sizes="(min-width: 60rem) 23rem, calc(100vw - 2.5rem)" />
          </figure>
        ))
      }
    </div>
  </section>

  <section class="container narrow block">
    <h2>{copy.steps.title}</h2>
    <ol class="steps">
      {copy.steps.items.map((step) => <li>{step}</li>)}
    </ol>
  </section>

  <section class="container narrow block">
    <h2>{copy.promises.title}</h2>
    <ul class="checks">
      {copy.promises.items.map((item) => <li>{item}</li>)}
    </ul>
  </section>
</UbermenschLayout>

<style>
  .hero {
    padding-block: 3rem 1rem;
  }

  .hero h1 {
    font-size: clamp(2rem, 1.5rem + 2vw, 2.75rem);
    font-weight: 750;
    margin-top: 0.5rem;
  }

  .status {
    margin-top: 1rem;
    font-weight: 600;
  }

  .hero .shot {
    margin-top: 2rem;
  }

  .block {
    padding-block: 2rem;
  }

  .block h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
  }

  .card {
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card);
  }

  .card h3 {
    font-size: 1.0625rem;
    font-weight: 650;
    margin-bottom: 0.375rem;
  }

  .card p {
    color: var(--muted-foreground);
  }

  .shots {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .steps {
    padding-left: 1.25rem;
    display: grid;
    gap: 0.5rem;
  }
</style>
